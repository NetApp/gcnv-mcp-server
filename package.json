    "vitest": "^4.0.14"
  },
  "dependencies": {
    "@google-cloud/local-auth": "3.0.1",
    "@google-cloud/netapp": "^0.14.1",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "axios": "^1.6.3",
    "zod": "^3.25.76"
  }
